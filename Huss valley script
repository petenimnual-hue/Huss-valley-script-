local function updatePlayerList()
	for _, child in pairs(scroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	for _, plr in pairs(Players:GetPlayers()) do
		if plr ~= player then
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -8, 0, isMobile and 36 or 28)
			btn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
			btn.Text = plr.Name
			btn.TextColor3 = Color3.fromRGB(230, 230, 230)
			btn.Font = Enum.Font.Gotham
			btn.TextSize = isMobile and 16 or 13
			btn.Parent = scroll
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

			btn.MouseButton1Click:Connect(function()
				local target = plr.Character
				if target and target:FindFirstChild("HumanoidRootPart") and rootPart then
					rootPart.CFrame = target.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
				end
			end)
		end
	end
	scroll.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
end

