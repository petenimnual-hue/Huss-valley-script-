-- ========== FLY ==========
local function startFly()
	if linearVel then return end

	attachment = Instance.new("Attachment")
	attachment.Parent = rootPart

	linearVel = Instance.new("LinearVelocity")
	linearVel.Attachment0 = attachment
	linearVel.MaxForce = math.huge
	linearVel.VectorVelocity = Vector3.zero
	linearVel.RelativeTo = Enum.ActuatorRelativeTo.World
	linearVel.Parent = rootPart

	alignOri = Instance.new("AlignOrientation")
	alignOri.Attachment0 = attachment
	alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOri.Responsiveness = 200
	alignOri.MaxTorque = math.huge
	alignOri.Parent = rootPart

	humanoid.PlatformStand = true

	if isMobile then
		mobileButtons.Visible = true
	end

	flyEnabled = true
	if flyButton then
		flyButton.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
		flyButton.Text = "FLY  [ON]"
	end

	flyConn = RunService.Heartbeat:Connect(function()
		if not rootPart or not rootPart.Parent then return end

		local cam = workspace.CurrentCamera
		local move = Vector3.zero

		local canMove = true
		if antiHitEnabled then
			canMove = false
			if not isMobile then
				if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.S) or
				   UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.D) then
					canMove = true
				end
			else
				if humanoid.MoveDirection.Magnitude > 0.1 then
					canMove = true
				end
			end
		end

		if canMove then
			if not isMobile then
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end

				if not antiHitEnabled then
					if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
					if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move += Vector3.new(0, -1, 0) end
				end
			else
				local md = humanoid.MoveDirection
				if md.Magnitude > 0.1 then
					local flat = Vector3.new(md.X, 0, md.Z)
					if flat.Magnitude > 0 then
						move = cam.CFrame:VectorToWorldSpace(Vector3.new(flat.X, 0, flat.Z))
					end
				end
				if not antiHitEnabled then
					if mobileUp then move += Vector3.new(0, 1, 0) end
					if mobileDown then move += Vector3.new(0, -1, 0) end
				end
			end
		end

		-- Use 25 speed while Anti-Hit is active
		local currentSpeed = antiHitEnabled and ANTIHIT_FLY_SPEED or FLY_SPEED

		if move.Magnitude > 0 then
			linearVel.VectorVelocity = move.Unit * currentSpeed
		else
			linearVel.VectorVelocity = Vector3.zero
		end

		-- Force stay underground + lay down while Anti-Hit is active
		if antiHitEnabled and lockedY then
			local pos = rootPart.Position
			rootPart.CFrame = CFrame.new(pos.X, lockedY, pos.Z)
				* CFrame.Angles(-math.pi/2, select(2, cam.CFrame:ToEulerAnglesYXZ()), 0)
		else
			alignOri.CFrame = cam.CFrame
		end
	end)
end

local function stopFly()
	if flyConn then flyConn:Disconnect() flyConn = nil end
	if linearVel then linearVel:Destroy() linearVel = nil end
	if alignOri then alignOri:Destroy() alignOri = nil end
	if attachment then attachment:Destroy() attachment = nil end
	if humanoid then humanoid.PlatformStand = false end
	mobileButtons.Visible = false
	mobileUp = false
	mobileDown = false
	flyEnabled = false

	if flyButton then
		flyButton.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
		flyButton.Text = "FLY  [OFF]"
	end
end

-- ========== NOCLIP ==========
local function startNoclip()
	if noclipConn then return end
	noclipEnabled = true
	noclipConn = RunService.Stepped:Connect(function()
		if not character then return end
		for _, part in pairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end)

	if noclipButton then
		noclipButton.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
		noclipButton.Text = "NOCLIP  [ON]"
	end
end

local function stopNoclip()
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end
	noclipEnabled = false
	if not character then return end
	for _, part in pairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			part.CanCollide = true
		end
	end

	if noclipButton then
		noclipButton.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
		noclipButton.Text = "NOCLIP  [OFF]"
	end
end

-- ========== TPWALK ==========
local function startTpWalk()
	lastTpTime = 0
	tpWalkConn = RunService.Heartbeat:Connect(function()
		if not humanoid or not rootPart then return end
		if humanoid.MoveDirection.Magnitude > 0.1 then
			local now = tick()
			if now - lastTpTime >= 1 then
				lastTpTime = now
				rootPart.CFrame = rootPart.CFrame + (rootPart.CFrame.LookVector * 2.5)
			end
		end
	end)
end

local function stopTpWalk()
	if tpWalkConn then tpWalkConn:Disconnect() tpWalkConn = nil end
end

-- ========== ANTI-HIT ==========
local function stopAntiHit()
	antiHitEnabled = false
	lockedY = nil

	if rootPart then
		local rayOrigin = rootPart.Position + Vector3.new(0, 50, 0)
		local rayDirection = Vector3.new(0, -100, 0)

		local rayParams = RaycastParams.new()
		rayParams.FilterDescendantsInstances = {character}
		rayParams.FilterType = Enum.RaycastFilterType.Exclude

		local result = workspace:Raycast(rayOrigin, rayDirection, rayParams)
		if result then
			rootPart.CFrame = CFrame.new(result.Position + Vector3.new(0, 3, 0))
		else
			rootPart.CFrame = rootPart.CFrame + Vector3.new(0, 6, 0)
		end
	end

	stopFly()
	stopNoclip()

	if antiHitButton then
		antiHitButton.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
		antiHitButton.Text = "ANTIHIT  [OFF]"
	end
end

local function startAntiHit()
	antiHitEnabled = true

	if rootPart then
		lockedY = rootPart.Position.Y - 3.5
	end

	startFly()
	startNoclip()

	if antiHitButton then
		antiHitButton.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
		antiHitButton.Text = "ANTIHIT  [ON]"
	end
end

