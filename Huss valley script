	btn.Font = Enum.Font.Gotham
	btn.TextSize = isMobile and 17 or 14
	btn.Parent = mainFrame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	local isOn = false
	btn.MouseButton1Click:Connect(function()
		isOn = not isOn
		btn.BackgroundColor3 = isOn and Color3.fromRGB(40, 160, 80) or Color3.fromRGB(60, 60, 80)
		btn.Text = name .. (isOn and "  [ON]" or "  [OFF]")
		onToggle(isOn)
	end)
	return btn
end

